# Copy to .env and fill in. Without a key the app runs in offline demo mode.
ANTHROPIC_API_KEY=
# Any current Claude model that supports PDF input and tool use.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to 1 to force the offline demo parser even when a key is present.
DEMO_MODE=0
# Parallel document extractions.
EXTRACTION_WORKERS=4
